{
	"compilerOptions": {
		"checkJs": true,
		"target": "ESNext",
		"module": "esnext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"maxNodeModuleJsDepth": 0,
		"strict": false,
	},
	"include": ["app/**/*", "./*.mjs"],
	"exclude": ["app/inject/**/*", "webpack.*"]
}
