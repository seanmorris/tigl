[*]
indent_style         = tab
indent_size          = 4
end_of_line          = lf
insert_final_newline = true
charset              = utf-8
trim_trailing_whitespace = true

[*.{frag,vert}]
indent_style = space
indent_size  = 2

[*.hwad]
end_of_line          = unset
insert_final_newline = unset
insert_final_newline = unset
charset              = unset
trim_trailing_whitespace = unset